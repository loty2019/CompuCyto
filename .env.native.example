DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=cytocore
DATABASE_PASSWORD=replace-with-a-strong-password
DATABASE_NAME=cytocore
DATABASE_SYNCHRONIZE=true

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

PORT=3000
FRONTEND_PORT=80
PYTHON_PORT=8001
NODE_ENV=production
ALLOWED_ORIGINS=http://cytocore.local,http://cytocore,http://localhost,http://127.0.0.1

PYTHON_CAMERA_URL=http://127.0.0.1:8001
RASPBERRY_PI_URL=http://192.168.100.1:8000
PI_API_UPSTREAM=http://192.168.100.1:8000
SERVICE_TIMEOUT=30000

IMAGES_PATH=C:/cytocore/runtime/media/captures
THUMBNAILS_PATH=C:/cytocore/runtime/media/thumbnails
IMAGE_SAVE_PATH=C:/cytocore/runtime/media/captures
VIDEO_SAVE_PATH=C:/cytocore/runtime/media/videos

HOST=0.0.0.0
DEBUG=false
CAMERA_SERIAL_NUMBER=
ALLOW_SIMULATED_CAMERA=false
DEFAULT_EXPOSURE=100.0
DEFAULT_GAIN=1.0
IMAGE_FORMAT=jpg
IMAGE_QUALITY=95
VIDEO_FORMAT=mp4
VIDEO_DEFAULT_DURATION=10.0
VIDEO_DEFAULT_PLAYBACK_FPS=25.0
VIDEO_DEFAULT_DECIMATION=1

MAX_X_POSITION=8800
MAX_Y_POSITION=11900
MAX_Z_POSITION=13200
MIN_X_POSITION=0
MIN_Y_POSITION=0
MIN_Z_POSITION=0
